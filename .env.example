# false = no token validation and no OBO (backends called without Authorization). Local dev only.
AUTH_ENABLED=true

# Entra ID app registration of this MCP server (required when AUTH_ENABLED=true)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change-me
# Short scope name(s) from "Expose an API", comma-separated
REQUIRED_SCOPES=access_as_user

# HTTP server
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
# Browser origins allowed to call the server directly, comma-separated (or *). Empty = CORS off.
# MCP Inspector in "Direct" mode: its UI origin, e.g. http://localhost:6274
CORS_ORIGINS=

# Diagnostics: DEBUG also turns on msal/httpx logs; LOG_PAYLOADS logs tool args/results and backend bodies
LOG_LEVEL=INFO
LOG_PAYLOADS=false

# TLS verification for outbound calls (backends, Entra, JWKS). Disabled by default.
SSL_VERIFY=false

# Backends are listed in backends.yaml. Per environment, override single fields of a backend:
# BACKENDS__<NAME>__<FIELD> (BASE_URL, AUTH, SCOPES comma-separated, API_KEY, TIMEOUT_SECONDS, SSE, ...)
BACKENDS__CONTACT_SEARCH__BASE_URL=https://<search-service>.search.windows.net/indexes/<index-name>
BACKENDS__CONTACT_SEARCH__API_KEY=<search query key>
BACKENDS__STAAT_INSIGHTS__BASE_URL=https://<staat-insights-host>/insights-api/v2
BACKENDS__STAAT_INSIGHTS__SCOPES=api://<staat-insights-app-id>/.default
BACKENDS__CIO__BASE_URL=https://<cio-host>
BACKENDS__CIO__SCOPES=api://<cio-app-id>/.default

# Lookup tools
# Who may see which splits: JSON list of {"userid": "...", "splits": ["..."]}
USER_SPLITS_FILE=user-splits.json
# Token claim holding the financial advisor's GPN, and how this app identifies itself to STAAT insights
GPN_CLAIM=gpn
INSIGHTS_PRODUCT=FA_PORTAL
# Stand-in user, only used when AUTH_ENABLED=false
# DEV_USER_ID=jane@example.com
# DEV_GPN=12345678
